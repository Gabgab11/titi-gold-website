# ---------------------------------------------------------------
# TITI GOLD — enquiry delivery settings
# Copy to .env for local development, and add the same values as
# Environment Variables in your hosting dashboard (e.g. Vercel).
# Leave a channel's values empty to keep it switched off.
# Never commit real keys.
# ---------------------------------------------------------------

# --- Email delivery via Resend (https://resend.com) ---
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "TITI GOLD Enquiries <enquiries@titigold.com>"
ENQUIRY_FROM_EMAIL=
# Default inbox(es) for all enquiries; comma-separate several
ENQUIRY_TO_EMAIL=
# Optional per-business inboxes (override ENQUIRY_TO_EMAIL for that business)
ENQUIRY_TO_EMAIL_EVENTS=
ENQUIRY_TO_EMAIL_FOUNDATION=
ENQUIRY_TO_EMAIL_FASHION=
# Send the enquirer an automatic "we've received it" email (true/false)
ENQUIRY_SEND_CONFIRMATION=false

# --- Database storage via Supabase (https://supabase.com) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Server-side secret key (sb_secret_...). NEVER put this in front-end code.
SUPABASE_SECRET_KEY=
# Table name (default: enquiries)
SUPABASE_TABLE=enquiries

# --- Security ---
# Only accept submissions from these origins (comma-separated). Recommended in production.
ALLOWED_ORIGINS=

# --- Local development only (scripts/dev-server.js) ---
# Save enquiries to a local file so you can test end to end without any service.
# Ignored in production.
ENQUIRY_LOCAL_FILE=
PORT=3000
